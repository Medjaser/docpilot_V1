APP_NAME=DocPilot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=docpilot
DB_USERNAME=docpilot
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
DOCUMENTS_DISK=documents
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@docpilot.local"
MAIL_FROM_NAME="${APP_NAME}"

# Stockage des documents : MinIO en local, Cloudflare R2 en recette/production
DOCUMENTS_S3_KEY=docpilot
DOCUMENTS_S3_SECRET=docpilot-secret
DOCUMENTS_S3_REGION=auto
DOCUMENTS_S3_BUCKET=docpilot-documents
DOCUMENTS_S3_ENDPOINT=http://minio:9000
DOCUMENTS_S3_URL=http://localhost:9000
DOCUMENTS_S3_PATH_STYLE=true

# Règles métier DocPilot (valeurs par défaut, surchargées par entreprise)
DOCPILOT_MAX_UPLOAD_KB=10240
DOCPILOT_EXPIRING_SOON_DAYS=30
DOCPILOT_PORTAL_LINK_DAYS=30
DOCPILOT_DOWNLOAD_URL_MINUTES=5

VITE_APP_NAME="${APP_NAME}"
